    "R15": 15,

    "SCREEN": 16384,
    "KBD": 24576
}

looping_list = {}


def loop_lines(lines):

    cnt = 0

    for l in lines:

        if l.startswith("("):
            name = l[1:-1]
            looping_list[name] = cnt
        else:
            cnt += 1


def get_address(address, address_dict, obj):
    
    if address_dict.get(obj, 'None') != 'None':
        return address, address_dict[obj]
    
    elif looping_list.get(obj, 'None') != 'None':
        return address, looping_list[obj]
    else:
        address_dict[obj] = address
        return address+1, address
    


def convert_attherate(addr, obj):

    if obj.isdigit():
        return format(int(obj), "016b")

    if obj in symbol_table:
        return format(symbol_table[obj], "016b")

    if obj in looping_list:
        return format(looping_list[obj], "016b")

    symbol_table[obj] = addr
    return format(addr, "016b")



def assembly_2_binary(lines):

    binary_lines = []
    var = 16

    for l in lines:

        if l.startswith("("):
            continue

        if l.startswith("@"):
            val = l[1:]

            if not val.isdigit() and val not in symbol_table and val not in looping_list:
                symbol_table[val] = var
                var += 1

            binary_lines.append(convert_attherate(var, val) + "\n")

        elif "=" in l:
            d, c = l.split("=")
            binary_lines.append(comp[c] + dest[d] + jump["null"] + "\n")

        elif ";" in l:
            c, j = l.split(";")
            binary_lines.append(comp[c] + dest["null"] + jump[j] + "\n")

    return binary_lines
        

def refine_lines(all_lines):
    res = []

    for l in all_lines:
        l = l.strip()

        if l == "" or l.startswith("//"):
            continue

        if "//" in l:
            l = l.split("//")[0].strip()

        res.append(l)

    return res
        


def extractlines(filename):
    with open(filename,'r') as file_pointer:
        lines = file_pointer.readlines()
    return lines


