        'M-1':'1111110010','D+M':'1111000010','D-M':'1111010011','M-D':'1111000111','D&M':'1111000000','D|M':'1111010101'}

dest = {'null':'000',"M": "001","D": "010","MD": "011","A": "100","AM": "101","AD": "110","AMD": "111"}

jump= {
    'null': "000",   # no jump
    "JGT": "001",
