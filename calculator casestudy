import tkinter as tk

root = tk.Tk()
root.title("Calculator")
root.geometry("550x450")

first_value = ""
second_value = ""
selected_operator = ""

def enter_number(number):
    old_value = entry.get()
    entry.delete(0,'end')
    new_value = old_value + number
    entry.insert(0, new_value)

def select_operation(operator):
    global first_value
    global second_value
    global selected_operator

    first_value = entry.get()
    entry.delete(0,'end')
    selected_operator = operator
    second_value = first_value + second_value

def calculate_result():
    global first_value
    global second_value
    global selected_operator

    second_value = entry.get()

    if selected_operator == '+':
        result = int(first_value) + int(second_value)
        entry.delete(0,'end')
        entry.insert(0, str(result))

    if selected_operator == '-':
        result = int(first_value) - int(second_value)
        entry.delete(0,'end')
        entry.insert(0, str(result))

    if selected_operator == '*':
        result = int(first_value) * int(second_value)
        entry.delete(0,'end')
        entry.insert(0, str(result))

    if selected_operator == '/':
        result = int(first_value) / int(second_value)
        entry.delete(0,'end')
        entry.insert(0, str(result))

def clear_all():
    entry.delete(0,'end')


frame = tk.Frame(root, background="lavender", width=550, height=450)
entry = tk.Entry(frame, width=55)
entry.place(x=20, y=30)

button_1 = tk.Button(frame, text='1', command=lambda: enter_number("1"))
button_1.place(x=30, y=100)

button_2 = tk.Button(frame, text='2', command=lambda: enter_number("2"))
button_2.place(x=70, y=100)

button_3 = tk.Button(frame, text='3', command=lambda: enter_number("3"))
button_3.place(x=110, y=100)

button_4 = tk.Button(frame, text='4', command=lambda: enter_number("4"))
button_4.place(x=30, y=140)

button_5 = tk.Button(frame, text='5', command=lambda: enter_number("5"))
button_5.place(x=70, y=140)

button_6 = tk.Button(frame, text='6', command=lambda: enter_number("6"))
button_6.place(x=110, y=140)

button_7 = tk.Button(frame, text='7', command=lambda: enter_number("7"))
button_7.place(x=30, y=180)

button_8 = tk.Button(frame, text='8', command=lambda: enter_number("8"))
button_8.place(x=70, y=180)

button_9 = tk.Button(frame, text='9', command=lambda: enter_number("9"))
button_9.place(x=110, y=180)

button_10 = tk.Button(frame, text='AC', command=clear_all)
button_10.place(x=30, y=220)

button_11 = tk.Button(frame, text='0', command=lambda: enter_number("0"))
button_11.place(x=70, y=220)

button_12 = tk.Button(frame, text='=', command=calculate_result)
button_12.place(x=110, y=220)

button_13 = tk.Button(frame, text='+', command=lambda: select_operation("+"))
button_13.place(x=140, y=100)

button_14 = tk.Button(frame, text='-', command=lambda: select_operation("-"))
button_14.place(x=140, y=140)

button_15 = tk.Button(frame, text='*', command=lambda: select_operation("*"))
button_15.place(x=140, y=180)

button_16 = tk.Button(frame, text='/', command=lambda: select_operation("/"))
button_16.place(x=140, y=220)

frame.pack()

root.mainloop()
