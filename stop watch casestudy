import tkinter as tk
import time

start_time = 0
running = False
elapsed_time = 0

def start():
    global start_time, running
    if running == False:
        start_time = time.time() - elapsed_time
        running = True
        update_time()

def stop():
    global running, elapsed_time
    if running == True:
        running = False
        elapsed_time = time.time() - start_time

def reset():
    global start_time, elapsed_time, running
    running = False
    elapsed_time = 0
    label.config(text="Time: 0")

def update_time():
    if running == True:
        current_time = time.time()
        elapsed = current_time - start_time

        label.config(text="Time: " + str(round(elapsed, 2)) + " sec")

        root.after(100, update_time)

root = tk.Tk()
root.title("Stopwatch")
root.geometry("300x200")

label = tk.Label(root, text="Time: 0", font=("Arial", 16))
label.pack(pady=20)

tk.Button(root, text="Start", command=start).pack()
tk.Button(root, text="Stop", command=stop).pack()
tk.Button(root, text="Reset", command=reset).pack()

root.mainloop()
