from PIL import Image

def apply_blur(image):

    pixels = image.load()
    width, height = image.size
    output_image = image.copy()
    output_pixels = output_image.load()

    kernel = [
        [1, 4, 6, 4, 1],
        [4,16,24,16,4],
        [6,24,36,24,6],
        [4,16,24,16,4],
        [1, 4, 6, 4, 1]
    ]

    for x in range(2, width - 2):
        for y in range(2, height - 2):

            red = green = blue = 0

            for i in range(-2, 3):
                for j in range(-2, 3):
                    r, g, b = pixels[x + i, y + j]
                    weight = kernel[i + 2][j + 2]

                    red += r * weight
                    green += g * weight
                    blue += b * weight

            output_pixels[x, y] = (
                red // 256,
                green // 256,
                blue // 256
            )

    return output_image

image_path = input("Enter image path:")

image = Image.open(image_path)

image = image.resize((500, 500))

image.show()

result = image
for _ in range(4):
    result = apply_blur(result)

result.show()

result.save("final_blur.jpg")
